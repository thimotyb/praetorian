# Praetorian Environment Variables

# Nodemailer SMTP Configuration (for sending emails)
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Optional: force notifications to a single email when testing
PRAETORIAN_TEST_RECIPIENT=

# Optional: override browser executable path used by Puppeteer.
# On ARM servers running under systemd, use a native Chromium wrapper instead of snap Chromium.
PRAETORIAN_BROWSER_EXECUTABLE_PATH=

# Optional: timeout/retry behavior for per-keyword result table
PRAETORIAN_KEYWORD_TIMEOUT_MS=60000
PRAETORIAN_KEYWORD_MAX_ATTEMPTS=3
